# Fonts 설정 ------------------------------- #
# font-family = "MesloLGS NF"
font-family = "JetBrainsMono Nerd Font"
# font-style = "Regular"
font-size = 14
# font-thicken = true
# cursor-style = bar

# 폰트 width 조정
adjust-cell-width = -6%
# adjust_cell-height = 20%

# Window설정 ------------------------------- #
# Windo Padding (x: horizontal,left/right, y : vertical, top/bottom)
window-padding-x = 10,10
window-padding-y = 6, 6

# Window size
window-height = 30
window-width = 120

# Window 기타 설정
split-divider-color = 547792
# https://fredrikaverpil.github.io/blog/2024/12/04/ghostty-on-macos
macos-titlebar-style = tabs
window-colorspace = display-p3

# shell 설정------------------------------- #
# shell-integration = none
shell-integration = zsh
shell-integration-features = cursor, sudo, no-title

# 창, pane 등을 닫을 때 확인창을 표시하지 않음.
confirm-close-surface = false

# 마우스 스크롤 멀티플라리어
mouse-scroll-multiplier = 0.7
mouse-hide-while-typing = true

# 투명도 설정 : 95%
background-opacity = 0.95

# GTK 설정------------------------------- #
gtk-single-instance = true
gtk-titlebar = true
gtk-wide-tabs=false

# Clipboard 설정------------------------------- #
clipboard-read = "allow"
clipboard-paste-protection = false

# theme ------------------------------- #
# check theme : ghostty +list-themes
# transparent tab case: change window-theme to ghostty
window-theme = dark
theme = Catppuccin Mocha

keybind = ctrl+shift+n=new_window

keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+k=goto_split:top

keybind = ctrl+s>h=new_split:left
keybind = ctrl+s>j=new_split:down
keybind = ctrl+s>k=new_split:up
keybind = ctrl+s>l=new_split:right
keybind = ctrl+s>f=toggle_split_zoom

keybind = ctrl+s>n=next_tab
keybind = ctrl+s>p=previous_tab

keybind = super+r=reload_config

keybind = super+ctrl+h=resize_split:left,10
keybind = super+ctrl+j=resize_split:down,10
keybind = super+ctrl+k=resize_split:up,10
keybind = super+ctrl+l=resize_split:right,10

# window-save-state = always
